<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="aicp"
           fetch="https://git@github.com/AICP"
           review="gerrit.aicp-rom.com"
           revision="refs/heads/v15.0"
           sync-j="8" />

  <remote  name="lineage"
           fetch="https://git@github.com/LineageOS"
           review="review.lineageos.org"
           revision="refs/heads/lineage-22.2"
           sync-j="8" />

  <remote  name="omni"
           fetch="https://git@github.com/omnirom"
           review="gerrit.omnirom.org"
           revision="refs/heads/android-15"
           sync-j="8" />

  <remote  name="github_native"
           fetch="https://git@github.com/"
           sync-c="true"
           sync-j="8" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/"
           revision="refs/heads/v15.0"
           sync-j="8" />

  <!-- Remove Packages -->
  <include name="snippets/remove.xml" />

  <!-- AICP additions -->
  <project path="device/aicp/sepolicy" name="device_aicp_sepolicy" remote="aicp" />
  <!-- <project path="external/colorkt" name="external_colorkt" remote="aicp" />
  <project path="external/themelib" name="external_themelib" remote="aicp" /> -->
  <project path="frameworks/opt/aicpgear" name="frameworks_opt_aicpgear" remote="aicp" />
  <project path="frameworks/opt/slimrecent" name="frameworks_opt_slimrecent" remote="aicp" />
  <project path="packages/services/OmniJaws" name="packages_services_OmniJaws" remote="aicp" />
  <project path="vendor/aicp" name="vendor_aicp" remote="aicp" />
  <project path="vendor/aicp-apps/AicpExtras" name="packages_apps_AicpExtras" remote="aicp" />
  <project path="vendor/jenkins" name="vendor_jenkins" remote="aicp" />

  <!-- AICP AOSP Repos -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="aicp" >
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="aicp" >
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>

  <!-- needed, because LOS track it for Trebuchet -->
  <project path="external/robolectric" name="platform/external/robolectric" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="aosp" />

  <project path="frameworks/base" name="frameworks_base" remote="aicp" />
  <!-- <project path="frameworks/libs/net" name="frameworks_libs_net" groups="pdk-cw-fs,pdk-fs" remote="aicp" /> -->
  <!--<project path="external/pulse" name="external_pulse" groups="pdk" remote="aicp" />-->
  <!--<project path="packages/apps/GameSpace" name="packages_apps_GameSpace" remote="aicp" />-->
  <project path="packages/apps/Launcher3" name="packages_apps_Launcher3" remote="aicp" />
  <project path="packages/apps/OnDeviceAppPrediction" name="packages_apps_OnDeviceAppPrediction" groups="pdk-fs" remote="aicp" />
  <!-- <project path="packages/apps/Pif" name="packages_apps_Pif" remote="aicp" /> -->
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs" remote="aicp" />
  <!-- <project path="packages/apps/SimpleDeviceConfig" name="packages_apps_SimpleDeviceConfig" remote="aicp" /> -->
  <project path="packages/apps/TilesWallpaper" name="packages_apps_TilesWallpaper" remote="aicp" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="aicp" />
  <project path="packages/modules/DnsResolver" name="packages_modules_DnsResolver" groups="pdk-cw-fs,pdk-fs" remote="aicp" />
  <project path="packages/overlays/AICP" name="packages_overlays_AICP" remote="aicp" />
  <project path="packages/resources/deviceparts" name="packages_resources_deviceparts" remote="aicp" />
  <project path="packages/resources/devicesettings" name="packages_resources_devicesettings" remote="aicp" />
  <project path="platform_manifest" name="platform_manifest" remote="aicp" />
  <project path="prebuilts/tools-aicp" name="android_prebuilts_tools-lineage" clone-depth="1" remote="lineage" />

  <!-- Other additions -->
  <project path="external/colorkt" name="ProtonAOSP/android_external_colorkt" remote="github" revision="sc-qpr3" />
  <project path="external/hosts" name="StevenBlack/hosts" remote="github" revision="master" clone-depth="10" />
  <project path="external/themelib" name="ProtonAOSP/android_external_themelib" remote="github" revision="sc-qpr3" />
  <project path="vendor/lawnicons" name="ProtonAOSP/android_vendor_lawnicons" remote="github" revision="sc-qpr3" />

</manifest>
